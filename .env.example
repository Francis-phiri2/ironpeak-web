# Server Port (default: 4000)
PORT=4000

# Server Host (0.0.0.0 binds to all network interfaces for container/cloud hosting)
HOST=0.0.0.0

# SQLite Database File Path (stored on persistent storage)
DATABASE_PATH=./data/ironpeak.sqlite

# Proxy trust (set to 1 when behind Cloudflare, Render, Railway, Nginx reverse proxy)
TRUST_PROXY=0

# Secret token for Bearer authentication on /api/admin/* endpoints
ADMIN_TOKEN=ironpeak-secret-admin-token-change-me-in-production

# Node environment
NODE_ENV=production
